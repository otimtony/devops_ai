# Copy this file to .env and fill in your values.

# Required: OpenAI API key used by the CrewAI agents (model: gpt-4o-mini).
OPENAI_API_KEY=sk-your-key-here

# Optional: application settings (defaults shown).
APP_NAME=DevOpsAI
ENVIRONMENT=development

# Optional: input size limits applied by the guardrails.
MAX_INCIDENT_DESCRIPTION_CHARS=5000
MAX_LOG_SAMPLE_CHARS=20000

# Optional: SQLite database location. Defaults to data/devops_ai.db in the project root.
# DATABASE_PATH=data/devops_ai.db
